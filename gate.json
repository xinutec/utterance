{
  "checks": [
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "fmt",
        "--all",
        "--check"
      ],
      "cwd": ".",
      "env": {},
      "name": "formatting",
      "timeout_s": 180
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "clippy",
        "--workspace",
        "--all-targets",
        "--",
        "-D",
        "warnings"
      ],
      "cwd": ".",
      "env": {
        "CARGO_TARGET_DIR": "/Users/pippijn/.cache/cargo/clippy-target"
      },
      "name": "clippy",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "test",
        "--workspace"
      ],
      "cwd": ".",
      "env": {},
      "name": "tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "cargo",
        "doc",
        "--no-deps",
        "--workspace"
      ],
      "cwd": ".",
      "env": {
        "RUSTDOCFLAGS": "-D rustdoc::broken_intra_doc_links"
      },
      "name": "rustdoc resolves every intra-doc link",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "scripts/gen-types.sh",
        "--check"
      ],
      "cwd": ".",
      "env": {},
      "name": "generated types are current",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "install",
        "--frozen-lockfile"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend deps match the lockfile",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "lint"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend lint",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "typecheck:e2e"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend typecheck (e2e)",
      "timeout_s": 900
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "test"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true",
        "NG_BUILD_MAX_WORKERS": "1"
      },
      "name": "frontend unit tests",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "nix",
        "run",
        "git+file:../../dev-lint?ref=HEAD#ng-build",
        "--",
        "--expect",
        "dist/utterance-web/browser",
        "--",
        "pnpm",
        "exec",
        "ng",
        "build"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend build",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "develop",
        "--no-warn-dirty",
        "--command",
        "pnpm",
        "run",
        "ui-check"
      ],
      "cwd": "frontend",
      "env": {
        "CI": "true"
      },
      "name": "frontend ui-check (phone-width layout harness)",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "build",
        "--no-warn-dirty",
        "--no-link",
        ".#default"
      ],
      "cwd": ".",
      "env": {},
      "name": "the package builds (what this repo publishes)",
      "timeout_s": 1800
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD#gate",
        "--",
        "--check-table",
        "gate.dhall",
        "gate.json"
      ],
      "cwd": ".",
      "env": {},
      "name": "the table matches its Dhall",
      "timeout_s": 300
    },
    {
      "argv": [
        "nix",
        "run",
        "git+file:../dev-lint?ref=HEAD",
        "--",
        "."
      ],
      "cwd": ".",
      "env": {},
      "name": "dev-lint",
      "timeout_s": 900
    }
  ],
  "name": "utterance"
}
